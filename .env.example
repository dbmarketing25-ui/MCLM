# Copie este arquivo para .env.local e preencha os valores.
# Tudo aqui é usado SOMENTE no servidor — nada é enviado ao navegador.

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chave "service_role" (secreta). Nunca coloque em código do navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Senha do painel (opcional) ---
# Se definida, /painel pede esta senha. As páginas de leitura continuam abertas.
PAINEL_SENHA=

# --- IA (opcional) ---
# Sem chave: modo grátis — o painel monta o pedido para colar no claude.ai.
# Com chave: o botão "Gerar resumo" faz tudo sozinho (cobrado por uso).
ANTHROPIC_API_KEY=
# Modelo usado para gerar os resumos.
AI_MODEL=claude-opus-5-5

# Origem do texto dos versículos:
#   ai        -> a própria IA escreve o texto (Almeida Revista e Atualizada); revise antes de publicar
#   bible-api -> busca o texto exato em bible-api.com (Almeida, domínio público, grafia antiga); usa a IA se falhar
BIBLE_TEXT_SOURCE=ai
